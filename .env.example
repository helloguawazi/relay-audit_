# Keys. Copy to .env and fill in. Never commit .env.
#
# The endpoint under audit.
RELAY_A_KEY=sk-replace-me

# Reference endpoint: OpenRouter. Publishes routing and pricing, and its model
# list is public so `catalog` collects it without a key. The key is only needed
# for `run`.
# https://openrouter.ai/keys
OPENROUTER_KEY=sk-or-replace-me

# Microsoft Foundry. Serves the Claude Messages API on an /anthropic base path
# and authenticates with an `api-key` header. Requires a paid Azure subscription
# with pay-as-you-go billing; student, free-trial and CSP subscriptions are not
# supported for Claude models.
# https://learn.microsoft.com/azure/foundry/foundry-models/how-to/use-foundry-models-claude
FOUNDRY_KEY=replace-me

# Optional: a second independently operated relay.
# Use a provider that is publicly known and that you actually paid for.
# Do not use a strawman: it is the fastest way to get a report dismissed.
PEER_KEY=sk-replace-me
