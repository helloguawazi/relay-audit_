# Keys. Copy to .env and fill in. Never commit .env.
#
# NOTHING HERE IS REQUIRED for the price comparison. `catalog` reads publicly
# published prices and needs no key unless a provider hides its list behind
# auth. Keys are only needed if you decide to run measurements.

# The endpoint under audit.
RELAY_A_KEY=sk-replace-me

# Reference endpoint: OpenRouter. Its model list and pricing are public, so
# `catalog` collects it without a key.
# https://openrouter.ai/keys
OPENROUTER_KEY=sk-or-replace-me

# Optional. Microsoft Foundry serves the Claude Messages API on an /anthropic
# base path and authenticates with an `api-key` header. Requires a PAID Azure
# subscription with pay-as-you-go billing; student, free-trial and CSP
# subscriptions are not supported for Claude models. Leave the endpoint
# disabled in config.toml unless you actually have one.
FOUNDRY_KEY=replace-me

# Optional: a second independently operated relay.
PEER_KEY=sk-replace-me
